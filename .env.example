# Postgres connection string
# Example (local): postgresql://postgres:password@localhost:5432/researchhub
# Example (hosted, e.g. Supabase/Neon/Railway): use the connection string they give you
DATABASE_URL="postgresql://user:password@localhost:5432/researchhub"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
